AGENTREC_ENV=server
AGENTREC_DATA_ROOT=/home/guosy2/agent_rec/dataset
AGENTREC_ARTIFACT_ROOT=/home/guosy2/agent_rec/artifacts
AGENTREC_DEVICE=cuda:0

# OpenAI-compatible chat endpoint (vLLM, SGLang, etc.)
AGENTREC_LLM_ENABLED=false
AGENTREC_LLM_BASE_URL=http://127.0.0.1:8000/v1
AGENTREC_LLM_API_KEY=EMPTY
AGENTREC_LLM_MODEL=/data/Qwen/Qwen3.5-4B
AGENTREC_LLM_MODEL_PATH=/data/Qwen/Qwen3.5-4B

# Local sentence-transformers path; leave empty only when using the HTTP provider.
AGENTREC_EMBEDDING_PROVIDER=sentence_transformers
AGENTREC_EMBEDDING_MODEL=/data/BAAI/bge-m3
AGENTREC_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
AGENTREC_EMBEDDING_API_KEY=EMPTY
